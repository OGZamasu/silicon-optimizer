<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Silicon Optimizer</string>
	<key>CFBundleExecutable</key>
	<string>SiliconOptimizer</string>
	<key>CFBundleIdentifier</key>
	<string>dev.siliconoptimizer.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Silicon Optimizer</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.1</string>
	<key>CFBundleVersion</key>
	<string>49</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- The swarm talks plain HTTP with bearer tokens over private networks (LAN peers,
	     tailnet CGNAT addresses like 100.x) by design; ATS's cleartext block would sever
	     every peer. Off-LAN transport security comes from WireGuard/Tailscale, not TLS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Silicon Optimizer talks to your other Silicon nodes (like a Windows PC running LATO.2) over your local network.</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT Licensed</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://optimize.zamasu.dev/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>30DR6iydV3mzNa+VCJ7a0aNyFGvF+2NkZ+2YxojvtOc=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
